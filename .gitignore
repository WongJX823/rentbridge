.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials

# Local API keys
config/openai.php
config/google.php
appPassword.txt

# Test/tooling output (regenerated by running the suites)
.phpunit.cache/
.playwright-mcp/
playwright-report/
test-results/
node_modules/

# DB backup dumps (backups/backup_db.ps1) — never commit real data
backups/*.sql

# Generated/signed contract PDFs — regenerated by test runs, contain user data
uploads/contracts/*.pdf
uploads/contracts/signed/*.pdf
uploads/generated_contracts/*.pdf

# Debug/test log noise
debug.log

# Test-run uploads (property photos/docs, e-signatures) — regenerated by test suites.
# Already-tracked fixture files (placeholders, img1-5.png, etc.) are unaffected by this.
uploads/properties/*.jpg
uploads/properties/*.png
uploads/property_docs/*.jpg
uploads/property_docs/*.pdf
uploads/signatures/*.png
