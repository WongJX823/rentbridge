.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials

# Local API keys / credentials
config/openai.php
config/google.php
includes/mail_config.php
appPassword.txt

# Test/tooling output (regenerated by running the suites)
.phpunit.cache/
.playwright-mcp/
playwright-report/
test-results/
node_modules/

# DB + uploads backups (backups/backup_db.ps1) — never commit real data
backups/*.sql
backups/*.zip

# Generated/signed contract PDFs — regenerated by test runs, contain user data
uploads/contracts/*.pdf
uploads/contracts/signed/*.pdf
uploads/generated_contracts/*.pdf

# Orphaned leftovers from the removed whole-page-merge flow (fe834f9) + mPDF's
# regenerated font-metrics cache — neither is source, never commit
uploads/contracts/pending_merge/
uploads/mpdf_tmp/

# Debug/test log noise
debug.log

# Test-run uploads (property photos/docs, e-signatures) — regenerated by test suites.
# Already-tracked fixture files (placeholders, img1-5.png, etc.) are unaffected by this.
uploads/properties/*.jpg
uploads/properties/*.png
uploads/property_docs/*.jpg
uploads/property_docs/*.pdf
uploads/property_docs/*.png
uploads/signatures/*.png

# Seeded E2E test accounts — plaintext test passwords, never commit
tests/seeded_test_accounts.txt
