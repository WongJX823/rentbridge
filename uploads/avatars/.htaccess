# Allow images, block scripts
<FilesMatch "\.(php|phtml|pl|py|jsp|asp|sh|cgi)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Avatars are public. Locally-checked-in fixtures (placeholder.jpg) exist on
# disk and are served normally below. Anything genuinely uploaded at runtime
# lives in R2 instead (Render's disk is ephemeral) — redirect to it only
# when the file isn't present locally, so this works the same whether R2 is
# configured or not.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ https://pub-d1e3932ca6864c7792937da039167eac.r2.dev/uploads/avatars/$1 [R=302,L]